VITE_API_BASE_URL=/api
DATABASE_URL=postgresql://...neon.tech/...
JWT_SECRET=your-secret-here

# Comma-separated list of origins allowed to make credentialed cross-origin
# requests to the API (CORS). Same-origin requests (frontend + API served
# from the same Vercel deployment) don't need this. Only set it if the
# frontend is hosted separately from the API, e.g.:
# ALLOWED_ORIGIN=https://your-app.vercel.app
